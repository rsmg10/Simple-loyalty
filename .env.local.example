# Copy this file to .env.local and fill in your own values (never commit the real file).

# Resend — email nudges when a customer is 1 stamp away. Get one at https://resend.com/api-keys
RESEND_API_KEY=
# Sender address for reminder emails — must be on a domain verified in Resend.
# Unset, the app falls back to Resend's sandbox sender (onboarding@resend.dev),
# which only delivers to your own Resend account email. The shop's name is
# used as the display name automatically.
EMAIL_FROM_ADDRESS=
# Physical mailing address appended to the email footer (CAN-SPAM, US recipients).
EMAIL_MAILING_ADDRESS=

# Language — "ar" (Arabic, right-to-left) or "en". The default for anyone who
# hasn't picked a language with the on-page toggle. Unset means English.
DEFAULT_LOCALE=

# Country code applied to phone numbers typed without one (e.g. "091 234 5678").
# Unset means 218 (Libya), which also enables the stricter Libyan mobile check.
PHONE_COUNTRY_CODE=

# Supabase — Project Settings -> API. Use the service_role key (server-side only, never exposed to the client).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Any random string — signs the staff-login cookie. Generate with: openssl rand -hex 32
STAFF_SESSION_SECRET=

# The deployed app's own URL (no trailing slash) — used to build the unsubscribe
# link in reminder emails. For local dev: http://localhost:3000
NEXT_PUBLIC_APP_URL=

# Apple Wallet — optional. Without these, the "Add to Apple Wallet" button is
# hidden and nothing else changes. See the "Wallet passes" section in
# README.md for how to obtain each value.
APPLE_PASS_TYPE_IDENTIFIER=
APPLE_TEAM_IDENTIFIER=
APPLE_PASS_SIGNER_CERT_BASE64=
APPLE_PASS_SIGNER_KEY_BASE64=
APPLE_PASS_SIGNER_KEY_PASSPHRASE=

# Google Wallet — optional. Without these, the "Add to Google Wallet" button
# is hidden and nothing else changes. See the "Wallet passes" section in
# README.md for how to obtain each value.
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
GOOGLE_WALLET_SERVICE_ACCOUNT_KEY=

# Multi-tenant scaffolding — optional, and irrelevant to a normal single-café
# deployment (leave unset). Only used by a hosted deployment serving multiple
# shops from subdomains of one root domain (e.g. yourapp.com, with shops at
# cafe-meridian.yourapp.com). See middleware.ts and getShop() in
# src/lib/shop-repo.ts. NEXT_PUBLIC_APP_ROOT_DOMAIN is the same value, also
# exposed to the browser — used by the owner login/signup pages to decide
# whether to route through self-serve onboarding (src/app/owner/onboarding)
# and to scope the owner session cookie across every shop's subdomain.
APP_ROOT_DOMAIN=
NEXT_PUBLIC_APP_ROOT_DOMAIN=

# Owner authentication — optional, and irrelevant to a normal single-café
# deployment (leave unset). Lets a shop link a real Supabase Auth account to
# manage its settings instead of the shared staff PIN. From Project Settings
# -> API: the Project URL (same value as SUPABASE_URL above, just also
# exposed to the browser) and the anon/public key (NOT the service_role key
# — this one is meant to be public). See the "Owner authentication" note in
# README.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
